    {
        "content": "<p><img alt=\"Screenshot 2026-10-06 at 4.25.37 PM.png\" class=\"inline-image\" data-original-content-type=\"image/png\" data-original-dimensions=\"1495x1210\" data-original-src=\"/user_uploads/53090/U1KuS93KKEjYLFITkToURTX3/Screenshot-2026-10-06-at-4.25.37PM.png\" src=\"/user_uploads/thumbnail/53090/U1KuS93KKEjYLFITkToURTX3/Screenshot-2026-10-06-at-4.25.37PM.png/840x560.webp\"></p>",

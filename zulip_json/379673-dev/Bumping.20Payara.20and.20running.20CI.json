    {
        "content": "<p><img alt=\"Screenshot 2026-08-12 at 15.54.25.heic\" class=\"inline-image\" data-original-content-type=\"image/heic\" data-original-dimensions=\"1792x1290\" data-original-src=\"/user_uploads/53090/pWZRT7eFNg9UgTtEC7B5IFNP/Screenshot-2026-08-12-at-15.54.25.heic\" data-transcoded-image=\"4032x3024.webp\" src=\"/user_uploads/thumbnail/53090/pWZRT7eFNg9UgTtEC7B5IFNP/Screenshot-2026-08-12-at-15.54.25.heic/840x560.webp\"></p>",
